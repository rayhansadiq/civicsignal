# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg2://civicsignal:civicsignal@localhost:5432/civicsignal

# --- CORS ------------------------------------------------------------------
# Which browser origins may call this API. The defaults below are what the
# code falls back to, so local development needs neither of these set.
# ALLOWED_ORIGINS=http://localhost:3000
# ALLOWED_ORIGIN_REGEX=^https://civicsignal[a-z0-9-]*\.vercel\.app$

# --- LLM provider ----------------------------------------------------------
# Default is Google Gemini's free tier, which speaks the OpenAI protocol.
# Get a free key (no credit card) at: https://aistudio.google.com/apikey
LLM_API_KEY=your-gemini-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Google retires model names fairly aggressively, and an older one can start
# returning 404 for keys created after its cutoff. If scoring fails with
# "model not found", list what your key can actually see:
#   python -c "from openai import OpenAI; import os; print([m.id for m in OpenAI(api_key=os.environ['LLM_API_KEY'], base_url=os.environ['LLM_BASE_URL']).models.list()])"
LLM_MODEL=gemini-3.5-flash-lite

# Gemini's free tier allows ~10 requests/minute, so we space requests out.
# Lower this if you move to a paid tier or run a local model.
LLM_SECONDS_BETWEEN_REQUESTS=6.5

# --- Switching providers ---------------------------------------------------
# The code is provider-agnostic; only these variables change.
#
# OpenAI:
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   LLM_SECONDS_BETWEEN_REQUESTS=0
#
# Groq:
#   LLM_API_KEY=gsk_...
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#
# Ollama (local, no key needed):
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1
#   LLM_SECONDS_BETWEEN_REQUESTS=0
